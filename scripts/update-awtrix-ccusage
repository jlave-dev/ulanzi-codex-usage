#!/bin/zsh
set -eu

PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
AWTRIX_CONFIG=${AWTRIX_CONFIG:-"$HOME/.config/ulanzi-codex-usage/config"}

if [[ -z ${AWTRIX_HOST:-} && -r "$AWTRIX_CONFIG" ]]; then
  AWTRIX_HOST=$(sed -n 's/^AWTRIX_HOST=//p' "$AWTRIX_CONFIG" | tail -1)
fi

format_cost() {
  awk -v cost="$1" 'BEGIN {
    if (cost < 100) value = sprintf("%.2f", cost)
    else if (cost < 1000) value = sprintf("%.1f", cost)
    else if (cost < 10000) value = sprintf("%.0f", cost)
    else if (cost < 100000) value = sprintf("%.1fk", cost / 1000)
    else value = sprintf("%.0fk", cost / 1000)

    if (length(value) > 5) {
      if (cost < 1000) value = sprintf("%.0f", cost)
      else value = sprintf("%.0fk", cost / 1000)
    }
    print value
  }'
}

format_tokens() {
  awk -v tokens="$1" 'BEGIN {
    if (tokens < 1000) value = sprintf("%.0f", tokens)
    else if (tokens < 1000000) value = sprintf("%.1fk", tokens / 1000)
    else if (tokens < 1000000000) value = sprintf("%.1fm", tokens / 1000000)
    else value = sprintf("%.1fb", tokens / 1000000000)

    if (length(value) > 5) {
      if (tokens < 1000000) value = sprintf("%.0fk", tokens / 1000)
      else if (tokens < 1000000000) value = sprintf("%.0fm", tokens / 1000000)
      else value = sprintf("%.0fb", tokens / 1000000000)
    }
    print value
  }'
}

if [[ ${1:-} == '--self-test' ]]; then
  [[ $(format_cost 32.219) == '32.22' ]]
  [[ $(format_cost 123.45) == '123.5' ]]
  [[ $(format_cost 1234.6) == '1235' ]]
  [[ $(format_cost 12345) == '12.3k' ]]
  [[ $(format_tokens 999) == '999' ]]
  [[ $(format_tokens 12345) == '12.3k' ]]
  [[ $(format_tokens 58353665) == '58.4m' ]]
  [[ $(format_tokens 1234567890) == '1.2b' ]]
  exit
fi

if [[ -z ${AWTRIX_HOST:-} ]]; then
  print -u2 "AWTRIX_HOST is not set. Run scripts/install-macos.sh or set it in $AWTRIX_CONFIG."
  exit 2
fi

usage=$(npx --yes ccusage@20.0.20 codex daily --last 1 --json --offline)
cost=$(jq -er '.daily[-1].costUSD // 0' <<<"$usage")
tokens=$(jq -er '.daily[-1].totalTokens // 0' <<<"$usage")
cost_text=$(format_cost "$cost")
token_text=$(format_tokens "$tokens")

cost_payload=$(jq -nc --arg text "$cost_text" '{
  draw: [
    ["rectFill", 0, 0, 31, 7, "#000000"],
    ["bitmap", 0, 0, 8, 8, [0,14805229,0,0,0,0,0,0,0,14805229,14805229,6066491,10998411,10998411,0,0,0,0,14805229,16771254,7844437,7844437,6066491,0,0,0,16771254,16771254,16771254,7844437,10998411,10538115,6066491,10998411,6066491,16771254,16771254,16771254,7844437,7844437,0,10998411,6066491,10998411,16771254,14805229,14805229,0,0,6066491,6066491,10998411,6066491,13424349,14805229,7238003,0,0,0,10998411,10998411,0,0,13424349,0]],
    ["pixel", 13, 0, "#FFFFFF"],
    ["line", 12, 1, 14, 1, "#FFFFFF"],
    ["line", 12, 2, 12, 3, "#FFFFFF"],
    ["line", 12, 3, 14, 3, "#FFFFFF"],
    ["line", 14, 4, 14, 5, "#FFFFFF"],
    ["line", 12, 5, 14, 5, "#FFFFFF"],
    ["pixel", 13, 6, "#FFFFFF"],
    ["text", 16, 1, $text, "#FFFFFF"]
  ],
  durationMs: 7000
}')

token_payload=$(jq -nc --arg text "$token_text" '{
  draw: [
    ["bitmap", 0, 0, 8, 8, [0,0,0,15311872,0,0,16767050,0,0,0,0,16767050,0,16767050,16777215,16767050,0,0,16767050,16774312,16767050,0,16767050,0,15311872,16767050,16774312,16777215,16774312,16767050,15311872,0,0,0,16767050,16774312,16767050,0,0,0,0,16767050,0,16767050,0,0,0,0,16767050,16777215,16767050,15311872,0,0,0,0,0,16767050,0,0,0,0,0,0]],
    ["text", 12, 1, $text, "#FFFFFF"]
  ],
  durationMs: 7000
}')

curl --fail --silent --show-error \
  --connect-timeout 5 --max-time 10 \
  -X PUT "http://${AWTRIX_HOST}/api/v1/apps/pushed/ccusage" \
  -H 'Content-Type: application/json' \
  --data-binary "$cost_payload" >/dev/null

curl --fail --silent --show-error \
  --connect-timeout 5 --max-time 10 \
  -X PUT "http://${AWTRIX_HOST}/api/v1/apps/pushed/tokens" \
  -H 'Content-Type: application/json' \
  --data-binary "$token_payload" >/dev/null

printf '%s $%s %s tokens\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" "$cost_text" "$token_text"
